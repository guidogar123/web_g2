                "jsCode": "const inputData = items[0].json;\nconst dateStr = inputData.fecha; // Ej: \"sábado, 28 de febrero de 2026\"\n\n// Intentamos extraer una fecha válida. \n// Nota: n8n tiene Luxon disponible como 'DateTime'\nconst now = DateTime.now();\nlet startDate = now.plus({ days: 1 }).set({ hour: 10, minute: 0, second: 0 });\n\ntry {\n  // Lógica de parsing simple para el formato detectado\n  // \"sábado, 28 de febrero de 2026\"\n  const parts = dateStr.split(' ');\n  const day = parseInt(parts[1]);\n  const year = parseInt(parts[parts.length - 1]);\n  const months = {\n    'enero': 1, 'febrero': 2, 'marzo': 3, 'abril': 4, 'mayo': 5, 'junio': 6,\n    'julio': 7, 'agosto': 8, 'septiembre': 9, 'octubre': 10, 'noviembre': 11, 'diciembre': 12\n  };\n  const month = months[parts[3].toLowerCase()] || 1;\n  \n  startDate = DateTime.fromObject({ year, month, day, hour: 10, minute: 0 });\n} catch (e) {\n  // Fallback a mañana si falla el parse\n}\n\nreturn [{\n  json: {\n    ...inputData,\n    start_date: startDate.toISO(),\n    end_date: startDate.plus({ minutes: 30 }).toISO()\n  }\n}];"
