# Copy this file to .env.local and fill in real values
#
# ── Variable pública (visible en el navegador) ──
# Se usa SOLO como flag booleano: cualquier valor truthy habilita el chat.
# La URL real del webhook de n8n es server-only (N8N_WEBHOOK_URL).
# El chat se conecta a un proxy interno (/api/webhook/n8n/chat), no directamente a n8n.
NEXT_PUBLIC_N8N_CHAT_ENABLED=true
#
# ── Variable servidor (NUNCA expuesta al cliente) ──
# URL del webhook de n8n para formularios (contacto, agenda) y chat.
# Se usa SOLO en API Routes del servidor.
N8N_WEBHOOK_URL=
